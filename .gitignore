# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Runtime state — these are created/overwritten as you use the app.
# Leading slash anchors each to the repo root: an unanchored `settings.json`
# also matches `.claude/settings.json`, which is tracked config, not state.
# patterns.json ships with starter patterns; uncomment to keep yours local:
# /patterns.json
/settings.json
/settings.json.tmp
/patterns.json.tmp
# masks are venue-specific — yours shouldn't follow the repo around
/masks.json
/masks.json.tmp

# User-uploaded ILDA files (keep the sample, ignore the rest)
ilda/*.ild
!ilda/spinning_star.ild

# Claude Code: the shared skill and project settings are tracked, but the
# per-machine permission overrides are not.
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db

# Build artifacts (PyInstaller / AppImage etc.)
build/
dist/
helios_lib/
*.spec
!pyinstaller.spec

# Field diagnostics (see crashlog.py) — per-run, never useful in the repo
/error.txt
/error.prev.txt
